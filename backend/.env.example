# Local dev database. SQLite keeps reviewer setup to one command.
DATABASE_URL="file:./dev.db"

# Auth0 tenant - values from the brief. These are public identifiers, not secrets.
AUTH0_ISSUER="https://dev-yg.us.auth0.com/"
AUTH0_AUDIENCE="https://bbl-candidate-test-api"
AUTH0_JWKS_URI="https://dev-yg.us.auth0.com/.well-known/jwks.json"

PORT=4000
CORS_ORIGIN="http://localhost:3000"
